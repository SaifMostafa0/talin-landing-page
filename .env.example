# Copy to .env for local development; set the same names in Vercel → Project → Settings → Environment Variables.
# Never prefix these with VITE_ — they are server-only.

# --- Sanity (Insights articles and open roles) ---
# Without SANITY_PROJECT_ID the site uses repository content only.
SANITY_PROJECT_ID=itvdkt2i
SANITY_DATASET=production
# Only needed if the dataset is private. Use a read-only (Viewer) token.
SANITY_READ_TOKEN=
# Set to "local" to ignore Sanity completely and serve repository content only.
CONTENT_SOURCE=

# --- Contact form (Resend) ---
# The form appears only when both RESEND_API_KEY and CONTACT_FROM are set;
# otherwise the Contact page shows an email button instead.
RESEND_API_KEY=
# Must use a domain verified in Resend, e.g. "Talin website <website@talindata.com>"
CONTACT_FROM=
# Defaults to info@talindata.com
CONTACT_TO=
